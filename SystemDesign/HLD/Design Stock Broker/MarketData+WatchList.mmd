flowchart LR
    %% LEFT
    subgraph A1[Clients]
        direction TB
        CLIENT[Web / Mobile User]
    end

    %% GATEWAYS
    subgraph A2[Gateways]
        direction TB
        APIGW[API Gateway]
        WSGW[WebSocket Gateway]
    end

    %% SERVICES
    subgraph A3[Services]
        direction TB
        WATCH[Watchlist Service]
        PRICE[Price Service / Price Tracker]
        EXAD[Exchange Feed Adapter]
    end

    %% DATABASES
    subgraph A4[Databases]
        direction TB
        WDB[(Watch DB)]
        TSDB[(Time-Series DB)]
    end

    %% CACHE / STREAMS
    subgraph A5[Cache / Streams]
        direction TB
        REDIS[(Redis Latest Price Cache)]
        MKAFKA[(Kafka Market Ticks)]
    end

    %% EXTERNAL
    subgraph A6[External Systems]
        direction TB
        EXCH[Exchange NSE / BSE]
    end

    CLIENT -->|watchlist APIs| APIGW
    CLIENT <-->|live quotes| WSGW

    APIGW -->|save / fetch watchlist| WATCH
    WATCH -->|store symbols| WDB

    WSGW <-->|subscribe / unsubscribe symbols| PRICE
    PRICE -->|read latest quote| REDIS
    PRICE -->|read candles / history| TSDB

    EXCH -->|market feed| EXAD
    EXAD -->|publish ticks| MKAFKA
    MKAFKA -->|tick updates| PRICE

    classDef svc fill:#ffffff,stroke:#111,stroke-width:2px,color:#111;
    classDef db fill:#ffffff,stroke:#111,stroke-width:1.5px,color:#111;
    classDef cache fill:#f8f8f8,stroke:#111,stroke-width:1.5px,color:#111;
    classDef ext fill:#fafafa,stroke:#111,stroke-width:2px,color:#111;
    classDef gw fill:#f3f3f3,stroke:#111,stroke-width:2.5px,color:#111;

    class APIGW,WSGW gw;
    class WATCH,PRICE,EXAD svc;
    class WDB,TSDB db;
    class REDIS,MKAFKA cache;
    class EXCH ext;