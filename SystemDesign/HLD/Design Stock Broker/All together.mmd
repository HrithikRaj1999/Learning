flowchart LR
    %% =========================
    %% SECTION 1: CLIENTS
    %% =========================
    subgraph SEC1[Clients]
        direction TB
        CLIENT[Web / Mobile User]
    end

    %% =========================
    %% SECTION 2: GATEWAYS
    %% =========================
    subgraph SEC2[Gateways]
        direction TB
        APIGW[API Gateway]
        WSGW[WebSocket Gateway]
    end

    %% =========================
    %% SECTION 3: SERVICES
    %% =========================
    subgraph SEC3[Services]
        direction TB
        USVC[User Service]
        FUNDS[Funds Service]
        WATCH[Watchlist Service]
        PRICE[Price Service]
        ORDER[Order Service]
        TRACK[Order Tracker Service]
        PORT[Portfolio Service]
        NOTIF[Notification Service]
        EXAD[Exchange Adapter]
    end

    %% =========================
    %% SECTION 4: DATABASES
    %% =========================
    subgraph SEC4[Databases]
        direction TB
        UDB[(User DB)]
        FDB[(Funds DB)]
        WDB[(Watch DB)]
        ODB[(Order DB)]
        TDB[(Trade / Position DB)]
        TSDB[(Time-Series DB)]
    end

    %% =========================
    %% SECTION 5: CACHE / STREAMS
    %% =========================
    subgraph SEC5[Cache / Streams]
        direction TB
        REDIS[(Redis Latest Price Cache)]
        MKAFKA[(Kafka Market Ticks)]
        OKAFKA[(Kafka Order Events)]
    end

    %% =========================
    %% SECTION 6: EXTERNALS
    %% =========================
    subgraph SEC6[External Systems]
        direction TB
        KYC[KYC Provider]
        BANK[Payment Gateway / Bank]
        EXCH[Exchange NSE / BSE]
    end

    %% Entry flows
    CLIENT -->|REST APIs| APIGW
    CLIENT <-->|Live prices / order updates| WSGW

    %% Gateway to services
    APIGW -->|signup / login| USVC
    APIGW -->|add / withdraw funds| FUNDS
    APIGW -->|watchlist APIs| WATCH
    APIGW -->|buy / sell / cancel order| ORDER
    APIGW -->|holdings / P&L| PORT
    WSGW <-->|subscribe symbols| PRICE

    %% Service to DB
    USVC -->|store user profile| UDB
    FUNDS -->|store balance / ledger| FDB
    WATCH -->|store symbols| WDB
    ORDER -->|create order| ODB
    TRACK -->|update status| ODB
    TRACK -->|save executed trade| TDB
    PORT -->|read holdings| TDB
    PRICE -->|read chart history| TSDB

    %% Service to cache / stream
    PRICE -->|read latest price| REDIS
    EXAD -->|publish market ticks| MKAFKA
    MKAFKA -->|market updates| PRICE
    EXAD -->|publish order updates| OKAFKA
    OKAFKA -->|ack / fill / reject| TRACK

    %% Notification path
    TRACK -->|notify user| NOTIF
    NOTIF -->|push update| WSGW

    %% External integrations
    USVC -->|verify identity| KYC
    FUNDS -->|move money| BANK
    ORDER -->|send order| EXAD
    EXCH -->|live market feed| EXAD
    EXCH -->|execution updates| EXAD

    %% Styling
    classDef svc fill:#ffffff,stroke:#111,stroke-width:2px,color:#111;
    classDef db fill:#ffffff,stroke:#111,stroke-width:1.5px,color:#111;
    classDef cache fill:#f8f8f8,stroke:#111,stroke-width:1.5px,color:#111;
    classDef ext fill:#fafafa,stroke:#111,stroke-width:2px,color:#111;
    classDef gw fill:#f3f3f3,stroke:#111,stroke-width:2.5px,color:#111;

    class APIGW,WSGW gw;
    class USVC,FUNDS,WATCH,PRICE,ORDER,TRACK,PORT,NOTIF,EXAD svc;
    class UDB,FDB,WDB,ODB,TDB,TSDB db;
    class REDIS,MKAFKA,OKAFKA cache;
    class KYC,BANK,EXCH ext;