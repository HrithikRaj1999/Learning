t / deny\n  comes back here", "fontSize": 11, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "h12", "type": "rectangle", "x": 6520, "y": 5310, "width": 300, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 699693251, "version": 100, "versionNonce": 1951140807, "isDeleted": false, "boundElements": [], "updated": 1787160000000, "link": null, "locked": false, "roundness": {"type": 3}}, {"id": "h13", "type": "text", "x": 6629.4400000000005, "y": 5324, "width": 81.12, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1654094178, "version": 100, "versionNonce": 1286529633, "isDeleted": false, "boundElements": [], "updated": 1787160000000, "link": null, "locked": false, "text": "Ride Service", "originalText": "Ride Service", "fontSize": 13, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "h14", "type": "text", "x": 6542, "y": 5350, "width": 131.56, "height": 55.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1108913757, "version": 100, "versionNonce": 1347459878, "isDeleted": false, "boundElements": [], "updated": 1787160000000, "link": null, "locked": false, "text": "- fare estimation\n- creates the ride row\n- triggers the matching\n  workflow", "originalText": "- fare estimation\n- creates the ride row\n- triggers the matching\n  workflow", "fontSize": 11, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "h15", "type": "rectangle", "x": 6520, "y": 5530, "width": 300, "height": 175, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1731466273, "version": 100, "versionNonce": 989609610, "isDeleted": false, "boundElements": [], "updated": 1787160000000, "link": null, "locked": false, "roundness": {"type": 3}}, {"id": "h16", "type": "text", "x": 6599.02, "y": 5544, "width": 141.96, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 112270418, "version": 100, "versionNonce": 308008713, "isDeleted": false, "boundElements": [], "updated": 1787160000000, "link": null, "locked": false, "text": "Ride Matching Service", "originalText": "Ride Matching Service", "fontSize": 13, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "h17", "type": "text", "x": 6542, "y": 5574, "width": 154.44, "height": 68.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 2033579411, "version": 100, "versionNonce": 324665867, "isDeleted": false, "boundElements": [], "updated": 1787160000000, "link": null, "locked": false, "text": "- picks the closest drivers\n- takes the Redis lock on\n  ONE driver at a time\n- CAS on the ride row when\n  the driver accepts", "originalText": "- picks the closest drivers\n- takes the Redis lock on\n  ONE driver at a time\n- CAS on the ride row