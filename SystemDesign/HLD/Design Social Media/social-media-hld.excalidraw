   }
  },
  {
   "id": "e294",
   "type": "text",
   "x": 1772,
   "y": 1828,
   "width": 241.28,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
