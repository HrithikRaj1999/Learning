   "boundElements": [],
   "updated": 1787160000000,
   "link": null,
   "locked": false,
   "text": "User            id  |  name  |  handle  |  bio\n\nFollow          followerId  |  followeeId  |  createdAt\n\nPost            id  |  authorId  |  text  |  mediaUrl  |  createdAt\n\nFeedEntry       userId  |  postId  |  createdAt        (the pre-built feed)\n\nLike            postId  |  userId                      (that pair = one like)\n\nComment         id  |  postId  |  userId  |  text  |  createdAt\n\nNotification    userId  |  type  |  actorId  |  postId  |  seen",
   "originalText": "User            id  |  name  |  handle  |  bio\n\nFollow          followerId  |  followeeId  |  createdAt\n\nPost            id  |  authorId  |  text  |  mediaUrl  |  createdAt\n\nFeedEntry       userId  |  postId  |  createdAt        (the pre-built feed)\n\nLike            postId  |  userId                      (that pair = one like)\n\nComment         id  |  postId  |  userId  |  text  |  createdAt\n\nNotification    userId  |  type  |  actorId  |  postId  |  seen",
   "fontSize": 13,
   "fontFamily": 6,
