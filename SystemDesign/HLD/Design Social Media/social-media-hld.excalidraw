   "updated": 1787160000000,
   "link": null,
   "locked": false,
   "text": "23   who you interact with most  +  how strong each follow is   ->   goes straight back into the graph and into feed ordering",
   "originalText": "23   who you interact with most  +  how strong each follow is   ->   goes straight back into the graph and into feed ordering",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "roundness": null
  },
  {
   "id": "e287",
   "type": "rectangle",
   "x": 1750,
   "y": 1400,
   "width": 700,
   "height": 360,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "dashed",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
