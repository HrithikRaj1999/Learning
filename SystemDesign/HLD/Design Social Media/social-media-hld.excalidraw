   "text": "B.  NON FUNCTIONAL  -  how well",
   "originalText": "B.  NON FUNCTIONAL  -  how well",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
