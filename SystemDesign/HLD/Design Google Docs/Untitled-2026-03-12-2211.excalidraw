      "index": "b6k",
      "roundness": null,
      "seed": 360945714,
      "version": 469,
      "versionNonce": 1382132840,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788367849003,
      "link": null,
      "locked": false,
      "text": "Documents (cassandra)\n- partition key: docId\n- docId\n- title\n- ownerId\n- acl (list of userId:role)\n- latestRevision\n- latestVersionId        <- points to VersionDB, not a raw s3key\n- version                <- optimistic lock, 409 on mismatch\n- deleted (flag)         <- drives 410, not 404\n- createdBy\n- createdTime\n- lastModifiedTime\n- lastModifiedBy\n- ... metadata",
      "fontSize": 11.237274866643226,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Documents (cassandra)\n- partition key: docId\n- docId\n- title\n- ownerId\n- acl (list of userId:role)\n- latestRevision\n- latestVersionId        <- points to VersionDB, not a raw s3key\n- version                <- optimistic lock, 409 on mismatch\n- deleted (flag)         <- drives 410, not 404\n- createdBy\n- createdTime\n- lastModifiedTime\n- lastModifiedBy\n- ... metadata",
      "autoResize": true,
      "lineHeight": 1.25
    },
