    {
      "id": "BBldPss8hQil9AYASs2Ep",
      "type": "text",
      "x": 2527.009742706522,
      "y": 10951.740626695942,
      "width": 228.20816040039062,
      "height": 215.5348780909358,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7d",
      "roundness": null,
      "seed": 2131608600,
      "version": 325,
      "versionNonce": 1937655912,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788367735935,
      "link": null,
      "locked": false,
      "text": "Redis Cluster (one cluster, five keys)\n\n1. doc:{docId}:sites   -> set of siteId:podId\n   presence registry, TTL 30s, heartbeat renews\n\n2. doc:{docId}:crdt    -> merged doc + revision\n   hot state, no TTL, evict on last socket close\n\n3. doc:{docId}         -> pub/sub channel\n   cross-pod fan-out\n\n4. site:{siteId}:seq   -> last sequence seen\n   dedupe key, TTL 1h\n\n5. presence:{docId}    -> cursor positions\n   TTL 10s, never hits Kafka or DB",
      "fontSize": 10.77674390454679,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis Cluster (one cluster, five keys)\n\n1. doc:{docId}:sites   -> set of siteId:podId\n   presence registry, TTL 30s, heartbeat renews\n\n2. doc:{docId}:crdt    -> merged doc + revision\n   hot state, no TTL, evict on last socket close\n\n3. doc:{docId}         -> pub/sub channel\n   cross-pod fan-out\n\n4. site:{siteId}:seq   -> last sequence seen\n   dedupe key, TTL 1h\n\n5. presence:{docId}    -> cursor positions\n   TTL 10s, never hits Kafka or DB",
      "autoResize": true,
      "lineHeight": 1.25
    },
