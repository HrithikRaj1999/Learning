    {
      "id": "aiWQ8EzRDvUG8piU8EsrC",
      "type": "text",
      "x": 2369.4591406579857,
      "y": 11846.848782460082,
      "width": 395.9368591308594,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
