    {
      "id": "6ySCSRcQ9VkoWEHQ0GOAm",
      "type": "text",
      "x": 2904.4930931030904,
      "y": 10565.902310431962,
      "width": 238.8563440817802,
      "height": 110.13831156803911,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6W",
      "roundness": null,
      "seed": 538680370,
      "version": 264,
      "versionNonce": 1876035608,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "wdsDIOyv8a6MpD1SbiQY0",
          "type": "arrow"
        }
      ],
      "updated": 1788367804492,
      "link": null,
      "locked": false,
      "text": "Reconciliation Svc (replay)\n\n- runs every 5 min\n- compares last revision in Kafka vs last saved in VersionDB\n- gap -> replay missing ops from Kafka -> rebuild -> S3\n- writes missing version row\n- alarms if gap keeps growing\n\ncovers: sync consumer dies after read, poison message in DLQ,\nRedis node death loses hot copy\nwithout it saved copy falls behind, returning user sees old doc",
      "fontSize": 8.010059023130115,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconciliation Svc (replay)\n\n- runs every 5 min\n- compares last revision in Kafka vs last saved in VersionDB\n- gap -> replay missing ops from Kafka -> rebuild -> S3\n- writes missing version row\n- alarms if gap keeps growing\n\ncovers: sync consumer dies after read, poison message in DLQ,\nRedis node death loses hot copy\nwithout it saved copy falls behind, returning user sees old doc",
      "autoResize": false,
      "lineHeight": 1.25
    },
