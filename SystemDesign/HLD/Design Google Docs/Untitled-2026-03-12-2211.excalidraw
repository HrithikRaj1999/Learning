    {
      "id": "u_eRBREwBvoeMEfv5YNdg",
      "type": "text",
      "x": 3205.7247839132933,
      "y": 10256.540475466545,
      "width": 308.83984375,
      "height": 210.6989037495605,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
