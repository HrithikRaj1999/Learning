      "seed": 713049448,
      "version": 243,
      "versionNonce": 794221160,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788367735935,
      "link": null,
      "locked": false,
      "text": "Kafka\n\nTopic: document.operations\n- key = docId\n- partitions: 256\n- replication 3, min in-sync 2\n- retention: 7 days\n- one partition per doc -> order kept\n\nPayload\n- docId\n- siteId\n- sequence\n- revision\n- type (insert / delete)\n- charId (position + siteId)\n- charValue\n- timestamp\n\nKafka not SQS\n- replay from any revision on reconnect\n- many consumer groups on same stream\n- per-doc order from partition key",
      "fontSize": 9.267573413901351,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kafka\n\nTopic: document.operations\n- key = docId\n- partitions: 256\n- replication 3, min in-sync 2\n- retention: 7 days\n- one partition per doc -> order kept\n\nPayload\n- docId\n- siteId\n- sequence\n- revision\n- type (insert / delete)\n- charId (position + siteId)\n- charValue\n- timestamp\n\nKafka not SQS\n- replay from any revision on reconnect\n- many consumer groups on same stream\n- per-doc order from partition key",
      "autoResize": true,
      "lineHeight": 1.25
    },
