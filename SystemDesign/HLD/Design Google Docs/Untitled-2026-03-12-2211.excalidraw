      "boundElements": null,
      "updated": 1788367735934,
      "link": null,
      "locked": false,
      "text": "{\n  \"eventId\":  \"outbox-8821\",      // dedupe key\n  \"type\":     \"doc.metadata.updated\",\n  \"docId\":    \"d1\",\n  \"version\":  7,                  // row version at write time\n  \"changed\":  [\"title\"],\n  \"ts\":       1735689600\n}",
      "fontSize": 8.324108143181002,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n  \"eventId\":  \"outbox-8821\",      // dedupe key\n  \"type\":     \"doc.metadata.updated\",\n  \"docId\":    \"d1\",\n  \"version\":  7,                  // row version at write time\n  \"changed\":  [\"title\"],\n  \"ts\":       1735689600\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "b5VFGHVFFUkx49KP_e9yd",
      "type": "text",
      "x": 2425.432856679219,
      "y": 10273.52444,
      "width": 215.6809663207811,
      "height": 155.56299505882532,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
