      "seed": 1536249368,
      "version": 281,
      "versionNonce": 1793927528,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788367735935,
      "link": null,
      "locked": false,
      "text": "CRDT chosen \n- ops can arrive in any order, result is same\n- no need to send one doc to one fixed server\n- works offline, each letter keeps its own id\n- merging happens on every device, not one server\n- if a server dies, user joins another one and catches up\n- easy to add more servers, no busy server problem",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CRDT chosen \n- ops can arrive in any order, result is same\n- no need to send one doc to one fixed server\n- works offline, each letter keeps its own id\n- merging happens on every device, not one server\n- if a server dies, user joins another one and catches up\n- easy to add more servers, no busy server problem",
      "autoResize": true,
      "lineHeight": 1.25
    },
