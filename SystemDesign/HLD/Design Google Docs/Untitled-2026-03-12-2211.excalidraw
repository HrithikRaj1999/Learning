    {
      "id": "d3RjCtJZwYi_PPoWw8Isk",
      "type": "text",
      "x": 3026.620697738058,
      "y": 11175.242455193349,
      "width": 222.97683715820312,
      "height": 168.02352990480222,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7u",
      "roundness": null,
      "seed": 91924504,
      "version": 598,
      "versionNonce": 1004626024,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "dtE66MIJ1-dQ0Oof6CCBl",
          "type": "arrow"
        },
        {
          "id": "V0Yw_nki9Pwk2x4MgRBti",
          "type": "arrow"
        }
      ],
      "updated": 1788367735935,
      "link": null,
      "locked": false,
      "text": "Operation Sync Svc\n\n- reads document.operations from committed offset\n- dedupe on (siteId, sequence)\n- row per op -> OperationsDB\n- rebuilds doc in memory\n- snapshot -> S3, every 1000 ops or 30s\n- version row -> VersionDB\n- tombstone GC at snapshot -> bounds growth\n- commit offset last, else crash loses snapshot\n- 3 fails -> DLQ, stops partition block\n\nturns the log into durable state\nsnapshot caps replay cost on rejoin",
      "fontSize": 9.601344565988699,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Operation Sync Svc\n\n- reads document.operations from committed offset\n- dedupe on (siteId, sequence)\n- row per op -> OperationsDB\n- rebuilds doc in memory\n- snapshot -> S3, every 1000 ops or 30s\n- version row -> VersionDB\n- tombstone GC at snapshot -> bounds growth\n- commit offset last, else crash loses snapshot\n- 3 fails -> DLQ, stops partition block\n\nturns the log into durable state\nsnapshot caps replay cost on rejoin",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k6WewjL4Pjbxy3VfPqYTQ",
      "type": "text",
      "x": 3478.5384066163233,
      "y": 10552.83339076369,
      "width": 205.26821526730606,
      "height": 261.13366823630867,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
