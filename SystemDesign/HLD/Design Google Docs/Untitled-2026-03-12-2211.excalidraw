    {
      "id": "RTV9QkjNJj2N8628qTke2",
      "type": "text",
      "x": 3083.7872076929807,
      "y": 11516.612219758823,
      "width": 172.7327423095703,
      "height": 266.44273564966386,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7t",
