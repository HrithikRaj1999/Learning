  "elements": [
    {
      "id": "AwTLIPVGT6PTqN_iitE-A",
      "type": "text",
      "x": 1286.8430358075384,
      "y": 10281.83430033227,
      "width": 473.03695162824425,
      "height": 840,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5j",
      "roundness": null,
      "seed": 1715555378,
      "version": 129,
      "versionNonce": 1613275240,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788367735934,
      "link": null,
      "locked": false,
      "text": "1. FUNCTIONAL REQUIREMENTS\n\n    Create / open / delete a document\n    Multiple users edit the same doc concurrently\n    Edits visible to all editors in real time\n    Cursor position + presence of other users\n    Version history: list versions, open a version\n    Offline edit, sync on reconnect\n\n2. NON-FUNCTIONAL\n    CAP\n          AP -> doc read, cursor, presence\n          CP -> op order per docId (one owner pod, monotonic rev)\n\n    Latency\n          op broadcast p99 < 100ms\n          doc open         < 500ms\n\n    Scale\n          100M DAU, 1% editing -> 1M live sockets\n          2 ops/sec/user (batched 50ms)\n\n    write  = 1M x 2   = 2M ops/s   peak 6M\n    read   = fan-out 3 editors     = 6M msg/s\n    ratio  ~ 3:1\n\n\n3. CAPACITY\n\n    op = 100B\n    ops/day = 2M x 100K s = 200B ops\n    Kafka   = 200B x 100B = 20 TB/day, 7d = 140 TB\n    \n    S3 snapshots\n      100M docs/day x 100KB = 10 TB/day -> ~3 PB/yr\n    \n    Redis hot\n      300K live docs x 1MB  = 300 GB  -> 10 nodes\n    \n    Bandwidth\n      out 6M x 200B = 1.2 GB/s\n      in  2M x 200B = 400 MB/s",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. FUNCTIONAL REQUIREMENTS\n\n    Create / open / delete a document\n    Multiple users edit the same doc concurrently\n    Edits visible to all editors in real time\n    Cursor position + presence of other users\n    Version history: list versions, open a version\n    Offline edit, sync on reconnect\n\n2. NON-FUNCTIONAL\n    CAP\n          AP -> doc read, cursor, presence\n          CP -> op order per docId (one owner pod, monotonic rev)\n\n    Latency\n          op broadcast p99 < 100ms\n          doc open         < 500ms\n\n    Scale\n          100M DAU, 1% editing -> 1M live sockets\n          2 ops/sec/user (batched 50ms)\n\n    write  = 1M x 2   = 2M ops/s   peak 6M\n    read   = fan-out 3 editors     = 6M msg/s\n    ratio  ~ 3:1\n\n\n3. CAPACITY\n\n    op = 100B\n    ops/day = 2M x 100K s = 200B ops\n    Kafka   = 200B x 100B = 20 TB/day, 7d = 140 TB\n    \n    S3 snapshots\n      100M docs/day x 100KB = 10 TB/day -> ~3 PB/yr\n    \n    Redis hot\n      300K live docs x 1MB  = 300 GB  -> 10 nodes\n    \n    Bandwidth\n      out 6M x 200B = 1.2 GB/s\n      in  2M x 200B = 400 MB/s",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ElDO9TEbJ-4ZboM5I9i1u",
      "type": "text",
      "x": 1286.843035703208,
      "y": 11154.081970843854,
      "width": 486.28900146484375,
      "height": 640,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5p",
      "roundness": null,
      "seed": 382865586,
      "version": 272,
      "versionNonce": 2114474856,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788367735934,
      "link": null,
      "locked": false,
      "text": "4. APIS\n\n    POST /v1/docs\n      Auth: Bearer <jwt>\n      Idempotency-Key: <uuid>\n      { title }\n      201 { docId, rev: 0 }\n      409 DOC_ALREADY_EXISTS      (same idem key, different body)\n      429 RATE_LIMITED\n    \n    GET /v1/docs/{docId}?rev=\n      200 { snapshotUrl (presigned S3), rev, acl }\n      403 NO_ACCESS\n      404 DOC_NOT_FOUND\n      410 DOC_DELETED\n    \n    WS /v1/docs/{docId}/edit?lastRev=\n      Auth: Bearer <jwt> in connect header\n      -> { type:\"op\", siteId, seq, op }\n      <- { type:\"ack\", seq, rev }\n      <- { type:\"op\", rev, op }\n      <- { type:\"cursor\", userId, pos }\n      1008 NOT_OWNER_POD          (client redials, pod lease moved)\n      409  REV_TOO_OLD            (client must reload snapshot)\n      429  OP_RATE_LIMITED\n    \n    GET /v1/docs/{docId}/versions?cursor=\n      200 { versions:[{versionId, rev, createdBy, ts}], nextCursor }\n    \n    GET /v1/docs/{docId}/versions/{versionId}\n      200 { snapshotUrl, rev }\n      410 VERSION_PRUNED",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. APIS\n\n    POST /v1/docs\n      Auth: Bearer <jwt>\n      Idempotency-Key: <uuid>\n      { title }\n      201 { docId, rev: 0 }\n      409 DOC_ALREADY_EXISTS      (same idem key, different body)\n      429 RATE_LIMITED\n    \n    GET /v1/docs/{docId}?rev=\n      200 { snapshotUrl (presigned S3), rev, acl }\n      403 NO_ACCESS\n      404 DOC_NOT_FOUND\n      410 DOC_DELETED\n    \n    WS /v1/docs/{docId}/edit?lastRev=\n      Auth: Bearer <jwt> in connect header\n      -> { type:\"op\", siteId, seq, op }\n      <- { type:\"ack\", seq, rev }\n      <- { type:\"op\", rev, op }\n      <- { type:\"cursor\", userId, pos }\n      1008 NOT_OWNER_POD          (client redials, pod lease moved)\n      409  REV_TOO_OLD            (client must reload snapshot)\n      429  OP_RATE_LIMITED\n    \n    GET /v1/docs/{docId}/versions?cursor=\n      200 { versions:[{versionId, rev, createdBy, ts}], nextCursor }\n    \n    GET /v1/docs/{docId}/versions/{versionId}\n      200 { snapshotUrl, rev }\n      410 VERSION_PRUNED",
      "autoResize": true,
      "lineHeight": 1.25
    },
