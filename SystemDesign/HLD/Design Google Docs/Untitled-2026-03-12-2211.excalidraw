      "versionNonce": 1688802152,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788367735935,
      "link": null,
      "locked": false,
      "text": "OperationsDB (cassandra)\n- write heavy, append only\n- partition key: docId\n- clustering key: revision (sorted)\n- docId\n- revision\n- siteId\n- sequence\n- type (insert / delete)\n- charId (position + siteId)\n- charValue\n- parentId\n- deleted (tombstone flag)\n- timestamp\n- ttl 30 days",
      "fontSize": 13.927128972603132,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OperationsDB (cassandra)\n- write heavy, append only\n- partition key: docId\n- clustering key: revision (sorted)\n- docId\n- revision\n- siteId\n- sequence\n- type (insert / delete)\n- charId (position + siteId)\n- charValue\n- parentId\n- deleted (tombstone flag)\n- timestamp\n- ttl 30 days",
      "autoResize": true,
      "lineHeight": 1.25
    },
