      "boundElements": [
        {
          "id": "6wnMvrMX3oyywvJGDr18D",
          "type": "arrow"
        }
      ],
      "updated": 1788367909819,
      "link": null,
      "locked": false,
      "text": "Document Metadata Svc\n\n- only writer of doc metadata\n- one transaction:\n    update Documents (title / acl), version + 1\n    insert outbox row\n- version mismatch -> 409 VERSION_CONFLICT\n- deleted flag -> 410, not 404\n- returns 200 before any async work\n- outbox relay -> SQS (behind the response)\n\nsync DB write, so user reads own write\noutbox, so DB commit and event never split",
      "fontSize": 9.573107388235405,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Document Metadata Svc\n\n- only writer of doc metadata\n- one transaction:\n    update Documents (title / acl), version + 1\n    insert outbox row\n- version mismatch -> 409 VERSION_CONFLICT\n- deleted flag -> 410, not 404\n- returns 200 before any async work\n- outbox relay -> SQS (behind the response)\n\nsync DB write, so user reads own write\noutbox, so DB commit and event never split",
      "autoResize": false,
      "lineHeight": 1.25
    },
