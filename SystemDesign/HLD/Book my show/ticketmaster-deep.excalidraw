    {
      "id": "SgqxaxSaG_P9v_cAnvxDa",
      "type": "text",
      "x": 3608.1832905345473,
      "y": 8708.909777459658,
      "width": 265.42687753668304,
      "height": 220.68450200421128,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2q",
      "roundness": null,
      "seed": 1043418741,
      "version": 1744,
      "versionNonce": 2093578107,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788084785152,
      "link": null,
      "locked": false,
      "text": "Reconciliation cron (10m)\n- runs inside booking svc onyl  \n- finds bookings PENDING > 10m \n  (webhook never arrived)\n- polls Razorpay for real order status\n- paid   -> confirm (refund if lock expired)\n- failed -> release seat\n\n- SELECT b.id, p.razorpay_order_id\nFROM bookings b JOIN payments p ON\np.booking_id = b.id\nWHERE b.status='PENDING' AND\nb.created_at < now() - interval '10 min';",
      "fontSize": 13.580584738720693,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reconciliation cron (10m)\n- runs inside booking svc onyl  \n- finds bookings PENDING > 10m \n  (webhook never arrived)\n- polls Razorpay for real order status\n- paid   -> confirm (refund if lock expired)\n- failed -> release seat\n\n- SELECT b.id, p.razorpay_order_id\nFROM bookings b JOIN payments p ON p.booking_id = b.id\nWHERE b.status='PENDING' AND b.created_at < now() - interval '10 min';",
      "autoResize": false,
      "lineHeight": 1.25
    },
