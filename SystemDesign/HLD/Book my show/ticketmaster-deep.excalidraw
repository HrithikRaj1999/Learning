      "seed": 1991483163,
      "version": 1063,
      "versionNonce": 1860551957,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788084074421,
      "link": null,
      "locked": false,
      "text": "Event svc (user — read)\n- reads Catalog DB, Redis cache 1h\n- no writes\n\nAdmin Event svc (write)\n- only writer to Catalog DB\n- outbox ->  catalog.changed\n  -> elastic-indexer, cache-invalidator",
      "fontSize": 12.59651073416149,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Event svc (user — read)\n- reads Catalog DB, Redis cache 1h\n- no writes\n\nAdmin Event svc (write)\n- only writer to Catalog DB\n- outbox ->  catalog.changed\n  -> elastic-indexer, cache-invalidator",
      "autoResize": true,
      "lineHeight": 1.25
    },
