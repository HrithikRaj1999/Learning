      "updated": 1788084558444,
      "link": null,
      "locked": false,
      "text": "Redis (Event svc cache)\n- GET event:{id} -> hit, else Catalog DB -> fill\n- TTL 1h, jittered to avoid mass expiry\n- SET NX lock on miss -> single-flight, stops thundering herd\n- invalidated by catalog-sync on admin edit\n- also holds: seats:{showId} hash, seat locks, rate limits",
      "fontSize": 6.2176946963412805,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis (Event svc cache)\n- GET event:{id} -> hit, else Catalog DB -> fill\n- TTL 1h, jittered to avoid mass expiry\n- SET NX lock on miss -> single-flight, stops thundering herd\n- invalidated by catalog-sync on admin edit\n- also holds: seats:{showId} hash, seat locks, rate limits",
      "autoResize": false,
      "lineHeight": 1.25
    },
