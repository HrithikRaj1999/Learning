    {
      "id": "I9CZ5IhsO1DBFOkUn1l-F",
      "type": "text",
      "x": 2784.454852574359,
      "y": 7675.126971822982,
      "width": 210.56787109375,
      "height": 125.9651073416149,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
