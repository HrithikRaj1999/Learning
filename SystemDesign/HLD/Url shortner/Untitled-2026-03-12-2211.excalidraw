      "seed": 184833064,
      "version": 18,
      "versionNonce": 1020682840,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788198210448,
      "link": null,
      "locked": false,
      "text": "POST /v1/urls, PATCH, DELETE\nsnowflake/KGS -> DB -> Redis -> 201\nunique constraint handles alias races\n\nGET /{shortCode}\nRedis -> DB on miss -> 302\nfire-and-forget Kafka url.clicked",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /v1/urls, PATCH, DELETE\nsnowflake/KGS -> DB -> Redis -> 201\nunique constraint handles alias races\n\nGET /{shortCode}\nRedis -> DB on miss -> 302\nfire-and-forget Kafka url.clicked",
      "autoResize": true,
      "lineHeight": 1.25
    },
