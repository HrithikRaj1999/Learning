d": false, "text": "W5  Video Service already returned CDN_DOMAIN + \"/\" + manifest_path  (~1 KB of JSON) - that is the server's entire job on watch.", "originalText": "W5  Video Service already returned CDN_DOMAIN + \"/\" + manifest_path  (~1 KB of JSON) - that is the server's entire job on watch.", "fontSize": 11, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "y139", "type": "text", "x": 7460, "y": 4960, "width": 715.0, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1002078799, "version": 100, "versionNonce": 1637466621, "isDeleted": false, "boundElements": [], "updated": 1786600000000, "link": null, "locked": false, "text": "ADAPTIVE BITRATE is client-driven: the player measures throughput and pulls the next chunk from a different rendition folder.\nSame segment number, different folder -> seamless switch. The server is never asked.", "originalText": "ADAPTIVE BITRATE is client-driven: the player measures throughput and pulls the next chunk from a different rendition folder.\nSame segment number, different folder -> seamless switch. The server is never asked.", "fontSize": 11, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}], "appState": {"gridSize": 20, "gridStep": 5, "gridModeEnabled": false, "viewBackgroundColor": "#ffffff", "lockedMultiSelections": {}}, "files": {"a766ccde7560224f13cc5b20db0d75e86730bd62": {"mimeType": "image/png", "id": "a766ccde7560224f13cc5b20db0d75e86730bd62", "dataURL": "data:image/png;base64,", "created": 1786984011587, "lastRetrieved": 1787059514299}}}