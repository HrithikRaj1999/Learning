{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"id": "o5rMxnAZ1jKA0xKfBuOHi", "type": "text", "x": 7057.128053303046, "y": 3042.9612348605915, "width": 349.6841050227004, "height": 55.35767300773613, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dotted", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bip", "roundness": null, "seed": 56294822, "version": 313, "versionNonce": 942592998, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false, "text": "Design a youtube", "fontSize": 44.286138406188904, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Design a youtube", "autoResize": true, "lineHeight": 1.25}, {"id": "tvzYUwS6qjzySrHntlqbr", "type": "text", "x": 5962.125780160886, "y": 3295.162428537712, "width": 483.44011722072173, "height": 660, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dotted", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "biq", "roundness": null, "seed": 1203263718, "version": 2470, "versionNonce": 1170556282, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false, "text": "Functional Requirement\n- User should be able upload video \n- User should be watch/stream video\n- Out of scope : Recommendation , Comments, like dislikes etc\n\nNon Functional Requirement\n- CAP Requirement \n    - Availability \n        - playback \n        - metadata \n        - view count\n        \n    - Consistency \n        - transcode \n- Latency\n    Video play <200ms\n\n- Estimates\n    - DAU - 100 M  \n    - Uploader \n            - 10% of DAU = 10M/10^5 sec= 100 upload/sec\n    - Watch \n            - 10 View/user/day\n            - 100M * 10 View/day => 1 B views/Day=10K views/sec\n     - Peak - 10X (100:1)\n        - watch 100K view per sec\n        - upload 1K upload/sec\n    - Storage\n        - Max allowed is 100 GB max video allowed\n        - Average 10 mins video @ 1 mbps =>  100MB \n       -  10M/Day *  100MB  = 10^7 * 10^5 => 1 GB Day\n       -  1 TB *365* 10 years= 10PB / 10 years => 100PB\n    ", "fontSize": 16, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Functional Requirement\n- User should be able upload video \n- User should be watch/stream video\n- Out of scope : Recommendation , Comments, like dislikes etc\n\nNon Functional Requirement\n- CAP Requirement \n    - Availability \n        - playback \n        - metadata \n        - view count\n        \n    - Consistency \n        - transcode \n- Latency\n    Video play <200ms\n\n- Estimates\n    - DAU - 100 M  \n    - Uploader \n            - 10% of DAU = 10M/10^5 sec= 100 upload/sec\n    - Watch \n            - 10 View/user/day\n            - 100M * 10 View/day => 1 B views/Day=10K views/sec\n     - Peak - 10X (100:1)\n        - watch 100K view per sec\n        - upload 1K upload/sec\n    - Storage\n        - Max allowed is 100 GB max video allowed\n        - Average 10 mins video @ 1 mbps =>  100MB \n       -  10M/Day *  100MB  = 10^7 * 10^5 => 1 GB Day\n       -  1 TB *365* 10 years= 10PB / 10 years => 100PB\n    ", "autoResize": false, "lineHeight": 1.25}, {"id": "o4I_BQvWOlTUe8H0f-wW-", "type": "rectangle", "x": 5945.186403373846, "y": 3281.27303690566, "width": 514.4391622016742, "height": 697.991631754514, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bir", "roundness": {"type": 3}, "seed": 642272294, "version": 618, "versionNonce": 1480025894, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false}, {"id": "KNwqNvl1QKlsg4DsvfQXC", "type": "text", "x": 6551.887727842053, "y": 3983.080513362411, "width": 215.25888127233233, "height": 23.830752342035428, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bis", "roundness": null, "seed": 1828181862, "version": 395, "versionNonce": 1991411258, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false, "text": "Core Entities tables in db", "fontSize": 19.064601873628344, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Core Entities tables in db", "autoResize": true, "lineHeight": 1.25}, {"id": "4upVppMzK8E4oXW9wdljF", "type": "rectangle", "x": 6526.948129709837, "y": 3944.6587390673494, "width": 705.0219756266933, "height": 431.2202267442337, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bit", "roundness": {"type": 3}, "seed": 605289126, "version": 952, "versionNonce": 1749783142, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false}, {"id": "mvaCCBv5_MiGcsft4sXtz", "type": "text", "x": 6581.678873524566, "y": 4033.9418559736796, "width": 595.1981301035347, "height": 238.3075234203543, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "biu", "roundness": null, "seed": 1112126950, "version": 603, "versionNonce": 1102687994, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false, "text": "\nVideo metadata\n- id\n- name\n- description\n- status: INITIATED | UPLOADED | TRANSCODING | READY | FAILED\n- rawS3Key        \"videos/vid_9f2a/raw.mp4\"\n- manifestPath   \"vid_9f2a/master.m3u8\"   \n\n", "fontSize": 19.064601873628344, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "\nVideo metadata\n- id\n- name\n- description\n- status: INITIATED | UPLOADED | TRANSCODING | READY | FAILED\n- rawS3Key        \"videos/vid_9f2a/raw.mp4\"\n- manifestPath   \"vid_9f2a/master.m3u8\"   \n\n", "autoResize": true, "lineHeight": 1.25}, {"id": "yr3pfzfZclXh7wWoZsouE", "type": "rectangle", "x": 6505.092031954433, "y": 3269.142094439465, "width": 762.7938384696494, "height": 627.2535162092237, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "biv", "roundness": {"type": 3}, "seed": 1621494054, "version": 1478, "versionNonce": 322459046, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false}, {"id": "ijc8F5gDRLz8E2wWCsrU_", "type": "text", "x": 6619.275745129911, "y": 4232.366737721845, "width": 388.75094539544403, "height": 56.35860671762136, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "biw", "roundness": null, "seed": 1855321190, "version": 735, "versionNonce": 459128762, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false, "text": "DB row:     manifestPath = \"vid_9f2a/master.m3u8\"\nRead time:  CDN_DOMAIN + \"/\" + manifestPath\n         =  \"https://cdn.youtube.com/vid_9f2a/master.m3u8\"", "fontSize": 15.028961791365695, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DB row:     manifestPath = \"vid_9f2a/master.m3u8\"\nRead time:  CDN_DOMAIN + \"/\" + manifestPath\n         =  \"https://cdn.youtube.com/vid_9f2a/master.m3u8\"", "autoResize": false, "lineHeight": 1.25}, {"id": "YzlHUTAgQvicXTjCXjT-C", "type": "text", "x": 6536.832121565765, "y": 3296.888265926632, "width": 699.3136596679688, "height": 560, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bix", "roundness": null, "seed": 1709602726, "version": 589, "versionNonce": 573223142, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false, "text": "LEGEND  -  UPLOAD\n1   POST /v1/videos/initiate   { title, sizeBytes, mimeType }\n2   gateway routes to Video Service (auth from token)\n3   server generates videoId, writes video row (status = INITIATED)\n4   writes upload_job row: s3_upload_id (S3 CreateMultipartUpload) + idempotency key\n     -> returns { videoId, chunkSize, totalParts }   (uploadId is NOT sent to client)\n5   client asks GET /videos/{id}/upload-urls?from=&to= (local HMAC signing, no S3 call)\n     then PUTs each 5MB part straight to S3.  Resume = GET /parts -> S3 ListParts\n6   Promise.all over all parts resolves -> client auto-calls POST /complete { parts[] }\n     server runs S3 CompleteMultipartUpload -> returns 202 (bytes safe, not playable yet)\n7   object-created event fires from the RAW bucket  (bucket state = source of truth)\n8   orchestrator consumes; transcoder can be down for an hour, Kafka holds the backlog\n9   chunker cuts raw video into aligned 10s segments\n10  fan-out: 60 segments x 4-5 renditions = ~600 idempotent tasks (spot instances, retry = 3s)\n11  each worker writes its .ts chunks; increments done_tasks on upload_job\n12  when done_tasks == total_tasks -> Packager writes index.m3u8 per rendition + master.m3u8\n13  emits video.ready\n14  video row updated: status = READY, manifestPath = \"vid_9f2a/master.m3u8\"\n15  search index fed from Kafka AFTER ready - never dual-write from the API\n\nLEGEND  -  WATCH\nW1  GET /v1/videos/{videoId}          W2  route\nW3  Redis 60s cache                    W4  miss -> read replica\nW5  server builds full URL: CDN_DOMAIN + manifestPath  (swap CDN = change 1 env var)\nW6  player reads master.m3u8 (rendition list) -> index.m3u8 (chunk list) -> loops chunks\n     ADAPTIVE BITRATE is client-driven: player measures throughput, picks next chunk from\n     a different folder. Same segment number, different rendition -> seamless switch.\nW7  edge miss -> shield        W8  shield miss -> S3 origin (<1% of traffic)", "fontSize": 16, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "LEGEND  -  UPLOAD\n1   POST /v1/videos/initiate   { title, sizeBytes, mimeType }\n2   gateway routes to Video Service (auth from token)\n3   server generates videoId, writes video row (status = INITIATED)\n4   writes upload_job row: s3_upload_id (S3 CreateMultipartUpload) + idempotency key\n     -> returns { videoId, chunkSize, totalParts }   (uploadId is NOT sent to client)\n5   client asks GET /videos/{id}/upload-urls?from=&to= (local HMAC signing, no S3 call)\n     then PUTs each 5MB part straight to S3.  Resume = GET /parts -> S3 ListParts\n6   Promise.all over all parts resolves -> client auto-calls POST /complete { parts[] }\n     server runs S3 CompleteMultipartUpload -> returns 202 (bytes safe, not playable yet)\n7   object-created event fires from the RAW bucket  (bucket state = source of truth)\n8   orchestrator consumes; transcoder can be down for an hour, Kafka holds the backlog\n9   chunker cuts raw video into aligned 10s segments\n10  fan-out: 60 segments x 4-5 renditions = ~600 idempotent tasks (spot instances, retry = 3s)\n11  each worker writes its .ts chunks; increments done_tasks on upload_job\n12  when done_tasks == total_tasks -> Packager writes index.m3u8 per rendition + master.m3u8\n13  emits video.ready\n14  video row updated: status = READY, manifestPath = \"vid_9f2a/master.m3u8\"\n15  search index fed from Kafka AFTER ready - never dual-write from the API\n\nLEGEND  -  WATCH\nW1  GET /v1/videos/{videoId}          W2  route\nW3  Redis 60s cache                    W4  miss -> read replica\nW5  server builds full URL: CDN_DOMAIN + manifestPath  (swap CDN = change 1 env var)\nW6  player reads master.m3u8 (rendition list) -> index.m3u8 (chunk list) -> loops chunks\n     ADAPTIVE BITRATE is client-driven: player measures throughput, picks next chunk from\n     a different folder. Same segment number, different rendition -> seamless switch.\nW7  edge miss -> shield        W8  shield miss -> S3 origin (<1% of traffic)", "autoResize": true, "lineHeight": 1.25}, {"id": "irJIp7RwbK9UrZgMDfsB2", "type": "rectangle", "x": 5756.203987921317, "y": 2995.8993968000786, "width": 5033.284324375094, "height": 1531.2577896304174, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "biy", "roundness": {"type": 3}, "seed": 2126811878, "version": 599, "versionNonce": 1874966650, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false}, {"id": "tII0JqtRRCaORm01O7pat", "type": "image", "x": 7400, "y": 5250, "width": 1801.3532434513238, "height": 1005.7555609269891, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bmN", "roundness": null, "seed": 1204082854, "version": 926, "versionNonce": 1113235814, "isDeleted": false, "boundElements": [], "updated": 1787060756704, "link": null, "locked": false, "status": "saved", "fileId": "a766ccde7560224f13cc5b20db0d75e86730bd62", "scale": [1, 1], "crop": null}, {"id": "y1", "type": "text", "x": 7460, "y": 3128, "width": 411.84000000000003, "height": 30.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1932544695, "version": 100, "versionNonce": 1263171677, "isDeleted": false, "boundElements": [], "updated": 1786600000000, "link": null, "locked": false, "text": "YouTube  -  Detailed Architecture", "originalText": "YouTube  -  Detailed Architecture", "fontSize": 24, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "y2", "type": "text", "x": 7460, "y": 3166, "width": 449.28000000000003, "height": 15.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1351617435, "version": 100, "versionNonce": 1501791123, "isDeleted": false, "boundElements": [], "updated": 1786600000000, "link": null, "locked": false, "text": "one row per service:   service  ->  cache / queue  ->  store  ->  schema", "originalText": "one row per service:   service  ->  cache / queue  ->  store  ->  schema", "fontSize": 12, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "y3", "type": "text", "x": 8150, "y": 3242, "width": 66.56, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 670042461, "version": 100, "versionNonce": 932334964, "isDeleted": false, "boundElements": [], "updated": 1786600000000, "link": null, "locked": false, "text": "SERVICES", "originalText": "SERVICES", "fontSize": 16, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "y4", "type": "text", "x": 8495, "y": 3242, "width": 183.04000000000002, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 815199637, "version": 100, "versionNonce": 393279198, "isDeleted": false, "boundElements": [], "updated": 1786600000000, "link": null, "locked": false, "text": "CACHE / QUEUE / OBJECT", "originalText": "CACHE / QUEUE / OBJECT", "fontSize": 16, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "y5", "type": "text", "x": 8925, "y": 3242, "width": 74.88, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1131675430, "version": 100, "versionNonce": 1203522224, "isDeleted": false, "boundElements": [], "updated": 1786600000000, "link": null, "locked": false, "text": "DATABASES", "originalText": "DATABASES", "fontSize": 16, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "roundness": null}, {"id": "y6", "type": "text", "x": 9340, "y": 3242, "width": 49.92, "height": 20.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1564932886, "version": 100, "versionNonce": 1613532520, "isDeleted": false, "boundElements": [], "updated": 1786600000000, "link": null, "locked": false, "text": "SCHEMA", "originalText": "SCHEMA", "fontSize": 16, "fontFamil