    {
      "id": "K4arKuaEUguCEMvr5vMRZ",
      "type": "text",
      "x": 1054.2645871915718,
      "y": 2852.876103876496,
      "width": 640.7873018418476,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8O",
      "roundness": null,
      "seed": 879080634,
      "version": 598,
      "versionNonce": 504925178,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786611380787,
      "link": null,
      "locked": false,
      "text": "4  SEAT MAP\n   GET /v1/shows/{showId}/seats\n   200  { showId, screen,          seats:[{ticketId,row,num,type,price,status}] }\n   status = AVAILABLE | HELD | SOLD      lazy expiry applied\n   no cache\n\n5  RESERVE  (lock, 5 min)\n   POST /v1/bookings\n   hdr  Authorization: Bearer <jwt>       userId from token, never body\n        Idempotency-Key: <uuid>\n   body { showId, ticketIds:[\"T6\",\"T7\"] }\n   201  { bookingId, status:\"PENDING\", amount, expiresAt }\n   409  { error:\"SEATS_TAKEN\", takenIds:[\"T7\"] }\n\n6  CONFIRM  (after payment)\n   POST /v1/bookings/{bookingId}/confirm\n   hdr  Idempotency-Key\n   body { paymentToken }\n   200  { bookingId, status:\"CONFIRMED\", tickets:[...] }\n   410  { error:\"LOCK_EXPIRED\" }\n\n7  RELEASE  (user backs out)\n   DELETE /v1/bookings/{bookingId}\n   204\n\n8  MY BOOKINGS\n   GET /v1/bookings?status=CONFIRMED\n   200  [ { bookingId, showId, seats, amount, status } ]",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4  SEAT MAP\n   GET /v1/shows/{showId}/seats\n   200  { showId, screen,          seats:[{ticketId,row,num,type,price,status}] }\n   status = AVAILABLE | HELD | SOLD      lazy expiry applied\n   no cache\n\n5  RESERVE  (lock, 5 min)\n   POST /v1/bookings\n   hdr  Authorization: Bearer <jwt>       userId from token, never body\n        Idempotency-Key: <uuid>\n   body { showId, ticketIds:[\"T6\",\"T7\"] }\n   201  { bookingId, status:\"PENDING\", amount, expiresAt }\n   409  { error:\"SEATS_TAKEN\", takenIds:[\"T7\"] }\n\n6  CONFIRM  (after payment)\n   POST /v1/bookings/{bookingId}/confirm\n   hdr  Idempotency-Key\n   body { paymentToken }\n   200  { bookingId, status:\"CONFIRMED\", tickets:[...] }\n   410  { error:\"LOCK_EXPIRED\" }\n\n7  RELEASE  (user backs out)\n   DELETE /v1/bookings/{bookingId}\n   204\n\n8  MY BOOKINGS\n   GET /v1/bookings?status=CONFIRMED\n   200  [ { bookingId, showId, seats, amount, status } ]",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vjsUdJNumGp16XzcMQdd5",
      "type": "text",
      "x": 20.22333649472239,
      "y": 4348.668711212495,
      "width": 457.7715148925781,
      "height": 50.48023751144229,
      "angle": 0,
      "strokeColor": "#1e1e1e",
