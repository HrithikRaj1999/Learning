      "index": "aT",
      "roundness": null,
      "seed": 135780946,
      "version": 3013,
      "versionNonce": 1872491494,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786611380787,
      "link": null,
      "locked": false,
      "text": "1  SEARCH\n   GET /v1/search?q=jawan&city=Pune&date=2026-08-11&limit=20&cursor=\n   200  { events:[{eventId,title,poster,language,rating}], nextCursor }\n   cache 5 min\n\n2  EVENT DETAILS\n   GET /v1/events/{eventId}\n   200  { id, title, description, language, durationMin, cast, poster }\n   cache 1 hr        no shows, no seats\n\n3  SHOWS OF AN EVENT\n   GET /v1/events/{eventId}/shows?city=Pune&date=2026-08-11\n   200  [ { showId, venueName, screenName, startTime, basePrice, seatsLeft } ]\n   cache 1 min       seatsLeft is eventual, not truth",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1  SEARCH\n   GET /v1/search?q=jawan&city=Pune&date=2026-08-11&limit=20&cursor=\n   200  { events:[{eventId,title,poster,language,rating}], nextCursor }\n   cache 5 min\n\n2  EVENT DETAILS\n   GET /v1/events/{eventId}\n   200  { id, title, description, language, durationMin, cast, poster }\n   cache 1 hr        no shows, no seats\n\n3  SHOWS OF AN EVENT\n   GET /v1/events/{eventId}/shows?city=Pune&date=2026-08-11\n   200  [ { showId, venueName, screenName, startTime, basePrice, seatsLeft } ]\n   cache 1 min       seatsLeft is eventual, not truth",
      "autoResize": false,
      "lineHeight": 1.25
    },
