      "originalText": "Ticket  \n- id\n- show_id (FK)\n- row, number\n- type\n- price\n- status\n      AVAILABLE\n      LOCKED\n      BOOKED\n- locked_by\n- lock_expiry\n- booking_id (FK)",
      "autoResize": true,
