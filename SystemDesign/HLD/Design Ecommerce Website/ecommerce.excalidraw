    {
      "id": "ccOvrgRt_MRWLur-RP5_V",
      "type": "text",
      "x": 1056.2646159381663,
      "y": 2542.819816856645,
      "width": 682.1041084127935,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
