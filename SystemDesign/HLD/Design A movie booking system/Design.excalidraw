      "height": 120,
      "index": "b4P",
      "roundness": null,
      "versionNonce": 1585137638,
      "text": "UPDATE show_seat\nSET status='LOCKED', locked_by=:u,\n    lock_expiry=now()+5min\nWHERE show_id=:s AND seat_id=:a\n  AND (status='AVAILABLE'\n       OR lock_expiry < now())",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "UPDATE show_seat\nSET status='LOCKED', locked_by=:u,\n    lock_expiry=now()+5min\nWHERE show_id=:s AND seat_id=:a\n  AND (status='AVAILABLE'\n       OR lock_expiry < now())",
      "autoResize": true,
      "lineHeight": 1.25
    },
