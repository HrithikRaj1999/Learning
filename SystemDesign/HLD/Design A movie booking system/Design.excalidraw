    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786352493177,
      "link": null,
      "locked": false,
      "version": 7,
      "id": "Y0oC9G7bVLkHWlCREmT4O",
      "index": "b64",
      "seed": 173450874,
      "versionNonce": 1955610406,
      "type": "text",
      "x": -1519.6694171296144,
      "y": 6076.270082175328,
      "width": 295.68,
      "height": 120,
      "roundness": null,
      "text": "UPDATE ticket\nSET status='LOCKED', locked_by=:u,\n    lock_expiry=now()+5min\nWHERE show_id=:s AND id IN (:ids)\n  AND (status='AVAILABLE'\n       OR lock_expiry < now())\n\nrows_affected == count(ids) ? WON : rollback",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "UPDATE ticket\nSET status='LOCKED', locked_by=:u,\n    lock_expiry=now()+5min\nWHERE show_id=:s AND id IN (:ids)\n  AND (status='AVAILABLE'\n       OR lock_expiry < now())\n\nrows_affected == count(ids) ? WON : rollback",
      "autoResize": true,
      "lineHeight": 1.25
    },
