      "versionNonce": 87482342,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786355290650,
      "link": null,
      "locked": false,
      "text": "1.Functional Requirement\n  -  Search events by title, city, date\n  -  View event details (description, language, duration, cast)\n  -  View shows for an event (venue, screen, time, price)\n  -  View seat map of a show (layout + live status)\n  -  Reserve seats (temporary hold, 5 min)\n  -  Pay and confirm booking\n  -  View my bookings",
      "fontSize": 22.137422177081245,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1.Functional Requirement\n  -  Search events by title, city, date\n  -  View event details (description, language, duration, cast)\n  -  View shows for an event (venue, screen, time, price)\n  -  View seat map of a show (layout + live status)\n  -  Reserve seats (temporary hold, 5 min)\n  -  Pay and confirm booking\n  -  View my bookings",
      "autoResize": false,
      "lineHeight": 1.25
    },
