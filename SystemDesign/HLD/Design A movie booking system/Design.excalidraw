    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786355236112,
      "link": null,
      "locked": false,
      "version": 101,
      "id": "bvtI5oVt7VBf36WxEQUe6",
      "index": "b7h",
      "seed": 1075272186,
      "versionNonce": 1873892646,
      "type": "text",
      "x": 263.3052916556126,
      "y": 4124.570247042867,
      "width": 238.95528922655873,
      "height": 96.97860764064885,
      "roundness": null,
      "text": "UPDATE ticket\nSET status='LOCKED', locked_by=:u,\n    lock_expiry=now()+5min\nWHERE show_id=:s AND id IN (:ids)\n  AND (status='AVAILABLE'\n       OR lock_expiry < now())\n\nrows_affected == count(ids) ? WON : rollback",
      "fontSize": 9.697860764064885,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "UPDATE ticket\nSET status='LOCKED', locked_by=:u,\n    lock_expiry=now()+5min\nWHERE show_id=:s AND id IN (:ids)\n  AND (status='AVAILABLE'\n       OR lock_expiry < now())\n\nrows_affected == count(ids) ? WON : rollback",
      "autoResize": true,
      "lineHeight": 1.25
    },
