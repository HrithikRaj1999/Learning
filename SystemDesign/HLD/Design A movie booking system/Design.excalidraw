      "x": -1000.6503104726058,
      "y": 2558.109583635546,
      "width": 893.705861840496,
      "height": 221.37422177081245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
