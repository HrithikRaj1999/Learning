{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug task scheduler",
      "program": "${workspaceFolder}/Low Level/ts_task_schedular/main.js",
      "cwd": "${workspaceFolder}/Low Level/ts_task_schedular",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug task scheduler (pause on first line)",
      "program": "${workspaceFolder}/Low Level/ts_task_schedular/main.js",
      "cwd": "${workspaceFolder}/Low Level/ts_task_schedular",
      "console": "integratedTerminal",
      "stopOnEntry": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
