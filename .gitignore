# ==========================================================================
# Global .gitignore for the Learning monorepo
# Covers: Node/TypeScript/React, Python, Go, Rust, SQL/Docker, OS & editors
# ==========================================================================

# --------------------------------------------------------------------------
# OS / system files
# --------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --------------------------------------------------------------------------
# Editor / IDE
# --------------------------------------------------------------------------
# Keep shared VS Code config (settings.json, extensions.json), ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# --------------------------------------------------------------------------
# Logs & temp
# --------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
tempCodeRunnerFile.*

# --------------------------------------------------------------------------
# Environment / secrets
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
*.local

# ==========================================================================
# Node / TypeScript / React
# ==========================================================================
node_modules/
dist/
build/
out/
coverage/
.next/
.nuxt/
.turbo/
.cache/
.parcel-cache/
.eslintcache
.npm/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================================================
# Python
# ==========================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
develop-eggs/
downloads/
.installed.cfg
*.manifest
*.spec
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ==========================================================================
# Go
# ==========================================================================
# Binaries / build output
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
# Test binaries / coverage
*.test
*.out
# Go workspace file
go.work.sum

# ==========================================================================
# Rust
# ==========================================================================
target/
**/*.rs.bk
Cargo.lock
# (Keep Cargo.lock for binaries: uncomment the next line to track it)
# !Cargo.lock

# ==========================================================================
# SQL / Docker / databases
# ==========================================================================
*.sqlite
*.sqlite3
*.db
pgdata/
.docker/
docker-compose.override.yml
